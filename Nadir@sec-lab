    print(f"  {C.CY}╚{'═'*8}╩{'═'*8}╩{'═'*22}╩{'═'*30}╝{C.X}")

def save_report(path, host, ip, results, scanned, secs):
    with open(path, "w", encoding="utf-8") as f:
        f.write(f"{TOOL} v{VERSION} — Owner: {OWNER}\n")
        f.write(f"Date   : {datetime.now():%Y-%m-%d %H:%M:%S}\n")
        f.write(f"Target : {host} ({ip})\nScanned: {scanned} ports in {secs:.2f}s\n\n")
        f.write(f"{'PORT':<8}{'STATE':<8}{'SERVICE':<22}BANNER\n")
        for port, svc, info in results:
            f.write(f"{port:<8}{'open':<8}{svc:<22}{info}\n")

# ───────────────────────── main ─────────────────────────
def main():
    ap = argparse.ArgumentParser(
        prog=TOOL, description=f"{TOOL} — TCP port scanner by {OWNER}",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="examples:\n  Nadir@sec-lab 127.0.0.1\n  Nadir@sec-lab 192.168.1.10 -p 1-1024 -b\n"
               "  Nadir@sec-lab scanme.nmap.org -t 800 -o report.txt")
    ap.add_argument("target", nargs="?", help="IP address or hostname")
    ap.add_argument("-p", "--ports", default="1-65535", help="ports, e.g. 22,80,1-1000 (default: all 65535)")
    ap.add_argument("-t", "--threads", type=int, default=500, help="threads (default 500)")
    ap.add_argument("-T", "--timeout", type=float, default=0.8, help="timeout seconds (default 0.8)")
    ap.add_argument("-b", "--banner", action="store_true", help="grab service banners")
    ap.add_argument("-o", "--output", help="save report to file")
    ap.add_argument("-y", "--yes", action="store_true", help="skip authorization prompt")
    ap.add_argument("-v", "--version", action="version", version=f"{TOOL} v{VERSION}")
    args = ap.parse_args()

    show_banner()
    if not args.target:
        try:
            args.target = input(f"  {C.G}Nadir@sec-lab{C.W}:{C.CY}~{C.W}$ {C.Y}target > {C.X}").strip()
        except (EOFError, KeyboardInterrupt):
            print(); return 1
    if not args.target:
        return 1

    try:
        ip = socket.gethostbyname(args.target)
        ports = parse_ports(args.ports)
    except (socket.gaierror, ValueError) as e:
        print(f"  {C.R}[x] {e}{C.X}"); return 1

    if not args.yes and not is_own_target(ip):
        ans = input(f"  {C.Y}[?] {ip} is not a private/local address. Do you have permission to scan it? [y/N] {C.X}")
        if ans.strip().lower() != "y":
            print(f"  {C.R}[x] Aborted.{C.X}"); return 1

    threads = raise_fd_limit(args.threads)
    print(f"  {C.G}[+]{C.W} Target  : {C.Y}{args.target} {C.GR}({ip}){C.X}")
    print(f"  {C.G}[+]{C.W} Ports   : {C.Y}{len(ports)}{C.W}   Threads: {C.Y}{threads}{C.W}   Timeout: {C.Y}{args.timeout}s{C.X}")
    print(f"  {C.G}[+]{C.W} Started : {C.GR}{datetime.now():%Y-%m-%d %H:%M:%S}{C.X}\n")

    results, secs = Scanner(ip, ports, threads, args.timeout, args.banner).run()
    print_table(results, ip, args.target)
    print(f"\n  {C.G}[✓]{C.W} Done: {C.G}{len(results)} open{C.W} / {len(ports)} scanned in {C.Y}{secs:.2f}s{C.X}")

    if args.output:
        save_report(args.output, args.target, ip, results, len(ports), secs)
        print(f"  {C.G}[✓]{C.W} Report saved: {C.Y}{args.output}{C.X}")
    print(f"\n  {C.GR}// {TOOL} — {OWNER}{C.X}\n")
    return 0

if __name__ == "__main__":
    sys.exit(main())
