def service_name(port):
    try:
        return socket.getservbyport(port, "tcp")
    except OSError:
        return EXTRA.get(port, "unknown")

# ───────────────────────── scanner ─────────────────────────
class Scanner:
    def __init__(self, ip, ports, threads, timeout, grab):
        self.ip, self.timeout, self.grab = ip, timeout, grab
        self.q = queue.Queue()
        for p in ports:
            self.q.put(p)
        self.total = len(ports)
        self.threads = min(threads, self.total)
        self.done = 0
        self.open = []
        self.lock = threading.Lock()
        self.stop = threading.Event()

    def banner(self, s, port):
        try:
            s.settimeout(1.0)
            if port in (80, 8000, 8080, 8888, 8443, 443):
                s.sendall(b"HEAD / HTTP/1.0\r\n\r\n")
            data = s.recv(128).decode(errors="ignore").strip().splitlines()
            return data[0][:50] if data else ""
        except OSError:
            return ""

    def worker(self):
        while not self.stop.is_set():
            try:
                port = self.q.get_nowait()
            except queue.Empty:
                return
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(self.timeout)
            try:
                if s.connect_ex((self.ip, port)) == 0:
                    info = self.banner(s, port) if self.grab else ""
                    with self.lock:
                        self.open.append((port, service_name(port), info))
            except OSError:
                pass
            finally:
                s.close()
                with self.lock:
                    self.done += 1

    def run(self):
        ts = [threading.Thread(target=self.worker, daemon=True) for _ in range(self.threads)]
        for t in ts:
            t.start()
        start = time.time()
        try:
            while any(t.is_alive() for t in ts):
                self.progress(start)
                time.sleep(0.1)
        except KeyboardInterrupt:
            self.stop.set()
            print(f"\n  {C.Y}[!] Interrupted — showing results so far...{C.X}")
        self.progress(start)
        print()
        return sorted(self.open), time.time() - start

    def progress(self, start):
        with self.lock:
            d = self.done
        pct = d / self.total if self.total else 1
        n = 30
        bar = "█" * int(n * pct) + "░" * (n - int(n * pct))
        el = time.time() - start
        rate = d / el if el > 0 else 0
        sys.stdout.write(
            f"\r  {C.CY}[{C.G}{bar}{C.CY}]{C.W} {pct*100:5.1f}% "
            f"{C.GR}{d}/{self.total}  {rate:,.0f} p/s  "
            f"{C.G}open:{len(self.open)}{C.X}   ")
        sys.stdout.flush()

# ───────────────────────── helpers ─────────────────────────
def parse_ports(spec):
    ports = set()
    for part in spec.split(","):
        part = part.strip()
        if "-" in part:
            a, b = part.split("-", 1)
            a, b = int(a), int(b)
            ports.update(range(a, b + 1))
        elif part:
            ports.add(int(part))
    if not ports or min(ports) < 1 or max(ports) > 65535:
        raise ValueError("ports must be within 1-65535")
    return sorted(ports)

def raise_fd_limit(want):
    if resource is None:
        return want
    try:
        soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
        target = min(hard, want + 100) if hard != resource.RLIM_INFINITY else want + 100
        if soft < target:
            resource.setrlimit(resource.RLIMIT_NOFILE, (target, hard))
            soft = target
        return max(10, min(want, soft - 50))
    except (ValueError, OSError):
        return want

def is_own_target(ip):
    a = ipaddress.ip_address(ip)
    return a.is_loopback or a.is_private

